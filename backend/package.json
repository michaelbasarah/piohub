{
  "name": "piohub-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "types": "tsc --declaration --emitDeclarationOnly --outDir ../frontend/src/types/backend",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@clerk/backend": "^2.0.0",
    "@trpc/server": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.0",
    "postgres": "^3.4.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "4.0.18"
  },
  "private": true,
  "license": "MIT"
}
