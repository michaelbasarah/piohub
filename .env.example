# Backend settings. Copy to .env (repo root) and fill in; .env is gitignored.
# The backend reads this file from the repo root (see backend/src/env.ts).

# Supabase -> Project Settings -> Database -> Connection string (use the pooler URL)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Clerk -> API keys (sk_test_/pk_test_ for development)
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Resend -> API keys. Leave RESEND_API_KEY empty to skip sending emails locally.
RESEND_API_KEY=
RESEND_FROM_EMAIL=pioHub <onboarding@resend.dev>

# Where the frontend runs. Used for CORS and for links in emails.
# Several origins: comma-separated, e.g. https://example.com,https://www.example.com
FRONTEND_URL=http://localhost:5173

PORT=3000
